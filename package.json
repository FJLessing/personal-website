{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "fjlessing.co.za, a Nuxt 4 / Vue 3 personal site with server-side rendering.",
  "license": "UNLICENSED",
  "author": "FJ Lessing <me@fjlessing.co.za>",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "bg:cost": "vite-node scripts/background-cost.ts",
    "bg:contrast": "vite-node scripts/background-contrast.ts",
    "browser:install": "scripts/install-headless-browser.sh",
    "screenshot": "node scripts/screenshot.mjs",
    "cv:build": "node scripts/build-cv.mjs",
    "test:watch": "vitest",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.14.5",
    "nuxt": "4.5.2",
    "prettier": "3.9.9",
    "semver": "7.8.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-node": "6.0.0",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
